### 添加设备
POST {{host}}/device/
Content-Type: application/json

{
  "name": "测试-02",
  "useIp": "192.168.1.22",
  "usePort": 503
}

### 修改设备
PUT {{host}}/device/
Content-Type: application/json

{
  "id": 1,
  "name": "测试-01",
  "useIp": "192.168.1.5",
  "usePort": 508,
  "registerTemplate": {
    "id": 3
  }
}

### 删除设备
DELETE {{host}}/device/15

### 设备列表
GET {{host}}/device/1/10

### 设备
GET {{host}}/device/1

### 添加定位器
POST {{host}}/device/locator
Content-Type: application/json

{
  "name":"温度",
  "slaveId":1,
  "dataType":2,
  "registerBit":-1,
  "registerRange":3,
  "registerOffset":0
}


### 添加模板
POST {{host}}/device/template
Content-Type: application/json

{
  "name": "模板1",
  "version": "1",
  "registerLocators": [
    {
      "id": 1
    }
  ]
}
